    "@types/chrome": "^0.0.287",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^28.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "animejs": "^4.4.1",
    "d3": "^7.9.0"
  }
